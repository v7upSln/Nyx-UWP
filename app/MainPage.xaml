<Page
    x:Class="Nyx_UWP.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Background="{ThemeResource NyxFrameBrush}">

    <Grid x:Name="Root" Background="{ThemeResource NyxFrameBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- tab strip -->
            <RowDefinition Height="Auto"/>   <!-- toolbar -->
            <RowDefinition Height="Auto"/>   <!-- bookmarks bar -->
            <RowDefinition Height="1"/>      <!-- divider -->
            <RowDefinition Height="*"/>      <!-- page -->
        </Grid.RowDefinitions>

        <!-- Tab strip (also the window drag area on desktop) -->
        <muxc:TabView x:Name="Tabs" Grid.Row="0" Padding="6,4,0,0" VerticalAlignment="Top"
                      IsAddTabButtonVisible="True" CanReorderTabs="False"
                      TabWidthMode="Equal" CloseButtonOverlayMode="Auto"
                      AddTabButtonClick="OnAddTab" TabCloseRequested="OnTabCloseRequested" SelectionChanged="OnTabSelected">
            <muxc:TabView.TabStripFooter>
                <Grid x:Name="DragRegion" MinWidth="48" Background="Transparent"/>
            </muxc:TabView.TabStripFooter>
        </muxc:TabView>

        <!-- Toolbar -->
        <Grid x:Name="Toolbar" Grid.Row="1" Background="{ThemeResource NyxToolbarBrush}" Padding="10,6,10,8" ColumnSpacing="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Grid.Column="0" Width="38" Height="38" Padding="0" Click="OnBack" ToolTipService.ToolTip="Back">
                <PathIcon Data="F1 M 0,0 L 0.02,0 L 0,0.02 Z M 16,16 L 15.98,16 L 16,15.98 Z M 6.83,2.64 L 1.95,7.53 A 0.67,0.67 0 0,0 1.95,8.47 L 6.83,13.36 L 7.78,12.41 L 4.04,8.67 L 14.25,8.67 L 14.25,7.33 L 4.04,7.33 L 7.78,3.59 L 6.83,2.64 L 6.83,2.64" Width="18" Height="18" />
            </Button>
            <Button x:Name="ForwardButton" Grid.Column="1" Width="38" Height="38" Padding="0" Click="OnForward" ToolTipService.ToolTip="Forward">
                <PathIcon Data="F1 M 0,0 L 0.02,0 L 0,0.02 Z M 16,16 L 15.98,16 L 16,15.98 Z M 11.96,8.67 L 1.75,8.67 L 1.75,7.33 L 11.96,7.33 L 8.22,3.59 L 9.17,2.64 L 14.05,7.53 A 0.67,0.67 0 0,1 14.05,8.47 L 9.17,13.36 L 8.22,12.41 L 11.96,8.67" Width="18" Height="18" />
            </Button>
            <Button x:Name="ReloadButton" Grid.Column="2" Width="38" Height="38" Padding="0" Click="OnReload" ToolTipService.ToolTip="Reload">
                <PathIcon Data="F1 M 0,0 L 0.02,0 L 0,0.02 Z M 16,16 L 15.98,16 L 16,15.98 Z M 10.42,6.21 L 13.98,6.21 L 14.25,5.95 L 14.25,2.38 A 0.45,0.45 0 0,0 13.49,2.07 L 12.18,3.37 A 6.21,6.21 0 0,0 8,1.75 C 4.55,1.75 1.75,4.55 1.75,8 C 1.75,11.45 4.55,14.25 8,14.25 A 6.22,6.22 0 0,0 14.22,8.61 A 0.56,0.56 0 0,0 13.72,8 A 0.57,0.57 0 0,0 13.11,8.5 A 5.11,5.11 0 0,1 8,13.13 C 5.17,13.13 2.87,10.83 2.87,8 C 2.87,5.17 5.17,2.87 8,2.87 A 5.1,5.1 0 0,1 11.4,4.16 L 10.1,5.45 A 0.45,0.45 0 0,0 10.42,6.21 L 10.42,6.21" Width="18" Height="18" />
            </Button>
            <Button x:Name="HomeButton" Grid.Column="3" Width="38" Height="38" Padding="0" Click="OnHome" ToolTipService.ToolTip="Home">
                <PathIcon Data="F1 M 0,0 L 0.02,0 L 0,0.02 Z M 16,16 L 15.98,16 L 16,15.98 Z M 14.34,7.15 L 9.18,1.99 A 1.66,1.66 0 0,0 6.84,1.99 L 1.68,7.15 A 0.54,0.54 0 0,0 2.39,7.95 L 2.39,12.76 A 1.73,1.73 0 0,0 4.12,14.49 L 11.9,14.49 A 1.73,1.73 0 0,0 13.64,12.76 L 13.64,7.95 A 0.54,0.54 0 0,0 13.96,8.07 A 0.54,0.54 0 0,0 14.34,7.15 M 9.09,13.41 L 6.93,13.41 L 6.93,9.95 L 7.36,9.52 L 8.66,9.52 L 9.09,9.95 L 9.09,13.41 M 12.55,12.91 L 12.03,13.41 L 10.17,13.41 L 10.17,10.17 A 1.73,1.73 0 0,0 8.44,8.44 L 7.58,8.44 A 1.73,1.73 0 0,0 5.85,10.17 L 5.85,13.41 L 3.99,13.41 L 3.47,12.91 L 3.47,6.89 L 7.61,2.75 A 0.57,0.57 0 0,1 8.42,2.75 L 12.55,6.89 L 12.55,12.91" Width="18" Height="18" />
            </Button>

            <!-- Address bar: site information on the left, bookmark and protection on the right -->
            <Border x:Name="UrlPill" Grid.Column="4" Margin="8,0" Height="38" CornerRadius="8"
                    Background="{ThemeResource NyxFieldBrush}" BorderThickness="2" BorderBrush="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="SiteInfoButton" Grid.Column="0" Width="32" Height="32" Margin="3,0,0,0" Padding="0" CornerRadius="6"
                            ToolTipService.ToolTip="Site information">
                        <Grid Width="18" Height="18">
                            <PathIcon Data="F1 M 0,0 L 0.02,0 L 0,0.02 Z M 16,16 L 15.98,16 L 16,15.98 Z M 11.12,7.22 L 11.12,4.88 C 11.12,3.15 9.72,1.75 8,1.75 C 6.28,1.75 4.88,3.15 4.88,4.88 L 4.88,7.22 A 1.56,1.56 0 0,0 3.31,8.78 L 3.31,12.69 A 1.56,1.56 0 0,0 4.88,14.25 L 11.12,14.25 A 1.56,1.56 0 0,0 12.69,12.69 L 12.69,8.78 A 1.56,1.56 0 0,0 11.12,7.22 M 5.85,4.88 C 5.85,3.69 6.81,2.73 8,2.73 C 9.19,2.73 10.15,3.69 10.15,4.88 L 10.15,7.22 L 5.85,7.22 L 5.85,4.88 M 11.71,12.8 L 11.24,13.27 L 4.76,13.27 L 4.29,12.8 L 4.29,8.66 L 4.76,8.2 L 11.24,8.2 L 11.71,8.66 L 11.71,12.8 L 11.71,12.8" Width="18" Height="18" x:Name="SiteLockIcon"/>
                            <PathIcon Data="F1 M 0,0 L 0.02,0 L 0,0.02 Z M 16,16 L 15.98,16 L 16,15.98 Z M 14.28,11.5 L 9.52,2.83 C 9.19,2.23 8.59,1.93 8,1.93 C 7.41,1.93 6.81,2.23 6.48,2.83 L 1.72,11.5 C 1.08,12.65 1.92,14.07 3.24,14.07 L 12.76,14.07 C 14.08,14.07 14.92,12.65 14.28,11.5 L 14.28,11.5 M 8.54,11.25 L 8.32,11.47 L 7.67,11.47 L 7.46,11.25 L 7.46,10.6 L 7.67,10.38 L 8.32,10.38 L 8.54,10.6 L 8.54,11.25 M 8.54,8.92 A 0.54,0.54 0 0,1 7.46,8.92 L 7.46,5.94 A 0.54,0.54 0 0,1 8.54,5.94 L 8.54,8.92" Width="18" Height="18" x:Name="SiteWarnIcon" Visibility="Collapsed"/>
                            <PathIcon Data="F1 M 0,0 L 0.02,0 L 0,0.02 Z M 16,16 L 15.98,16 L 16,15.98 Z M 8.54,7.08 A 0.54,0.54 0 0,0 7.46,7.08 L 7.46,10.93 A 0.54,0.54 0 0,0 8.54,10.93 L 8.54,7.08 M 8.32,4.53 L 7.67,4.53 L 7.46,4.75 L 7.46,5.4 L 7.67,5.62 L 8.32,5.62 L 8.54,5.4 L 8.54,4.75 L 8.32,4.53 M 8,2.58 C 10.99,2.58 13.42,5.01 13.42,8 C 13.42,10.99 10.99,13.42 8,13.42 C 5.01,13.42 2.58,10.99 2.58,8 C 2.58,5.01 5.01,2.58 8,2.58 M 8,1.5 A 6.5,6.5 0 1,0 8,14.5 A 6.5,6.5 0 0,0 8,1.5" Width="18" Height="18" x:Name="SiteInfoIcon" Visibility="Collapsed"/>
                        </Grid>
                        <Button.Flyout>
                            <Flyout x:Name="SiteFlyout" Placement="Bottom" Opening="OnSiteOpening">
                                <StackPanel x:Name="SitePanel" Width="330" Spacing="12">
                                    <TextBlock x:Name="SiteTitle" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource NyxTextBrush}"/>
                                    <TextBlock x:Name="SiteConnection" TextWrapping="Wrap" Foreground="{ThemeResource NyxTextBrush}"/>
                                    <TextBlock x:Name="SiteCert" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource NyxMutedBrush}"/>
                                    <Border Height="1" Background="{ThemeResource NyxDividerBrush}"/>
                                    <TextBlock x:Name="SiteBlocked" TextWrapping="Wrap" Foreground="{ThemeResource NyxTextBrush}"/>
                                    <TextBlock x:Name="SiteCookies" TextWrapping="Wrap" Foreground="{ThemeResource NyxTextBrush}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="ClearCookiesButton" Content="Clear cookies for this site" Click="OnClearSiteCookies"/>
                                        <Button Content="Protection" Click="OnOpenShieldFromSite"/>
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <TextBox x:Name="UrlBox" Grid.Column="1" VerticalAlignment="Center" InputScope="Url" BorderThickness="0"
                             Background="Transparent" PlaceholderText="Search or enter address" FontSize="14"
                             KeyDown="OnUrlKeyDown" GotFocus="OnUrlGotFocus" LostFocus="OnUrlLostFocus" TextChanged="OnUrlTextChanged">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                        </TextBox.Resources>
                    </TextBox>

                    <Button x:Name="BookmarkButton" Grid.Column="2" Width="32" Height="32" Padding="0" CornerRadius="6" Click="OnBookmarkClick"
                            ToolTipService.ToolTip="Bookmark this page (Ctrl+D)">
                        <Grid Width="18" Height="18">
                            <PathIcon Data="F1 M 0,0 L 0.02,0 L 0,0.02 Z M 16,16 L 15.98,16 L 16,15.98 Z M 4.7,14.49 C 4.41,14.49 4.12,14.4 3.87,14.22 A 1.4,1.4 0 0,1 3.33,12.73 L 4.08,9.81 L 1.76,7.88 A 1.4,1.4 0 0,1 1.32,6.36 A 1.4,1.4 0 0,1 2.57,5.39 L 5.58,5.2 L 6.69,2.4 C 6.91,1.86 7.42,1.51 8,1.51 C 8.58,1.51 9.09,1.86 9.31,2.4 L 10.42,5.2 L 13.43,5.39 A 1.4,1.4 0 0,1 14.68,6.36 A 1.4,1.4 0 0,1 14.24,7.88 L 11.92,9.81 L 12.66,12.73 A 1.4,1.4 0 0,1 12.13,14.22 A 1.4,1.4 0 0,1 10.55,14.27 L 8,12.66 L 5.45,14.27 A 1.41,1.41 0 0,1 4.7,14.49 L 4.7,14.49 M 8,2.59 A 0.32,0.32 0 0,0 7.7,2.8 L 6.45,5.92 L 5.99,6.26 L 2.64,6.47 A 0.32,0.32 0 0,0 2.35,6.7 A 0.31,0.31 0 0,0 2.45,7.05 L 5.03,9.2 L 5.21,9.75 L 4.38,13 A 0.31,0.31 0 0,0 4.51,13.34 C 4.56,13.38 4.71,13.46 4.88,13.35 L 7.71,11.56 L 8.29,11.56 L 11.13,13.35 A 0.32,0.32 0 0,0 11.49,13.34 A 0.32,0.32 0 0,0 11.62,13 L 10.79,9.74 L 10.97,9.2 L 13.55,7.05 A 0.31,0.31 0 0,0 13.65,6.7 A 0.32,0.32 0 0,0 13.36,6.47 L 10.01,6.26 L 9.55,5.92 L 8.3,2.8 A 0.32,0.32 0 0,0 8,2.59" Width="18" Height="18" x:Name="StarOffIcon"/>
                            <PathIcon Data="F1 M 0,0 L 0.02,0 L 0,0.02 Z M 16,16 L 15.98,16 L 16,15.98 Z M 4.1,9.57 L 1.63,7.53 A 1.04,1.04 0 0,1 1.3,6.4 A 1.04,1.04 0 0,1 2.23,5.68 L 5.42,5.47 L 5.85,5.15 L 7.03,2.19 C 7.19,1.79 7.57,1.53 8,1.53 C 8.43,1.53 8.81,1.79 8.97,2.19 L 8.97,2.19 L 10.15,5.15 L 10.58,5.47 L 13.77,5.68 C 14.2,5.7 14.56,5.99 14.7,6.4 C 14.83,6.81 14.7,7.25 14.37,7.53 L 11.91,9.57 L 11.75,10.08 L 12.54,13.17 C 12.64,13.58 12.49,14.02 12.14,14.27 A 1.05,1.05 0 0,1 10.97,14.31 L 8.27,12.6 L 7.73,12.6 L 5.03,14.31 C 4.67,14.54 4.21,14.52 3.86,14.27 A 1.04,1.04 0 0,1 3.46,13.17 L 4.24,10.09 L 4.1,9.57 L 4.1,9.57" Width="18" Height="18" x:Name="StarOnIcon" Foreground="{ThemeResource NyxAccentBrush}" Visibility="Collapsed"/>
                        </Grid>
                    </Button>

                    <Button x:Name="ShieldButton" Grid.Column="3" Height="32" Margin="0,0,3,0" Padding="9,0" CornerRadius="6"
                            ToolTipService.ToolTip="Protection">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Grid Width="20" Height="20" VerticalAlignment="Center">
                                <PathIcon Data="F0 M 0,0 L 0.02,0 L 0,0.02 Z M 16,16 L 15.98,16 L 16,15.98 Z M 8,0.5 C 9.98,1.87 11.96,2.56 14.09,2.63 L 14.09,7.51 C 14.09,11.24 11.73,14.21 8,15.5 C 4.27,14.21 1.91,11.24 1.91,7.51 L 1.91,2.63 C 4.04,2.56 6.02,1.87 8,0.5 M 4.27,8.42 L 5.26,7.43 L 7.16,9.33 L 10.89,5.6 L 11.88,6.59 L 7.16,11.31 L 4.27,8.42" Width="20" Height="20" x:Name="ShieldOnIcon" Foreground="{ThemeResource NyxAccentBrush}"/>
                                <PathIcon Data="F0 M 0,0 L 0.02,0 L 0,0.02 Z M 16,16 L 15.98,16 L 16,15.98 Z M 8,0.5 C 9.98,1.87 11.96,2.56 14.09,2.63 L 14.09,7.51 C 14.09,11.24 11.73,14.21 8,15.5 C 4.27,14.21 1.91,11.24 1.91,7.51 L 1.91,2.63 C 4.04,2.56 6.02,1.87 8,0.5 M 8,2.67 C 9.43,3.66 10.85,4.15 12.39,4.21 L 12.39,7.72 C 12.39,10.4 10.69,12.54 8,13.47 C 5.31,12.54 3.61,10.4 3.61,7.72 L 3.61,4.21 C 5.15,4.15 6.57,3.66 8,2.67" Width="20" Height="20" x:Name="ShieldOffIcon" Foreground="{ThemeResource NyxMutedBrush}" Visibility="Collapsed"/>
                            </Grid>
                            <TextBlock x:Name="ShieldCount" Text="" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                       TextLineBounds="TrimToCapHeight" Foreground="{ThemeResource NyxTextBrush}" Visibility="Collapsed"/>
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout x:Name="ShieldFlyout" Placement="Bottom" Opening="OnShieldOpening" Closed="OnShieldClosed">
                                <StackPanel x:Name="ShieldPanel" Width="330" Spacing="14">
                                    <TextBlock x:Name="ShieldTitle" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource NyxTextBrush}"/>
                                    <TextBlock x:Name="ShieldSummary" TextWrapping="Wrap" Foreground="{ThemeResource NyxMutedBrush}"/>
                                    <ToggleSwitch x:Name="SiteSwitch" Header="Protection on this site" OnContent="On" OffContent="Off" Toggled="OnSiteToggled"/>
                                    <ToggleSwitch x:Name="GlobalSwitch" Header="Protection everywhere" OnContent="On" OffContent="Off" Toggled="OnGlobalToggled"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Update filters" Click="OnUpdateFilters" Style="{StaticResource AccentButtonStyle}"/>
                                        <Button Content="Reload page" Click="OnReload"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ShieldStatus" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource NyxMutedBrush}"/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </Border>

            <Button x:Name="BookmarksToolbarButton" Grid.Column="5" Width="38" Height="38" Padding="0" Click="OnToolbarBookmarks" ToolTipService.ToolTip="Bookmarks">
                <PathIcon Data="F1 M 0,0 L 0.02,0 L 0,0.02 Z M 16,16 L 15.98,16 L 16,15.98 Z M 13.38,2.5 L 2.62,2.5 A 1.12,1.12 0 0,0 1.5,3.62 L 1.5,12.38 A 1.12,1.12 0 0,0 2.62,13.5 L 13.38,13.5 A 1.12,1.12 0 0,0 14.5,12.38 L 14.5,5.12 A 1.12,1.12 0 0,0 13.38,4 L 8.5,4 L 7,2.5 L 13.38,2.5 M 2.62,3.5 L 6.59,3.5 L 8.09,5 L 13.5,5 L 13.5,12.38 L 13.12,12.75 L 2.88,12.75 L 2.5,12.38 L 2.5,3.62 L 2.62,3.5" Width="18" Height="18" />
            </Button>
                        <Button x:Name="MenuButton" Grid.Column="6" Width="38" Height="38" Padding="0" ToolTipService.ToolTip="Menu">
                <PathIcon Data="F1 M 0,0 L 0.02,0 L 0,0.02 Z M 16,16 L 15.98,16 L 16,15.98 Z M 13.38,4.62 L 2.62,4.62 A 0.62,0.62 0 0,1 2.62,3.38 L 13.38,3.38 A 0.62,0.62 0 0,1 13.38,4.62 M 13.38,8.62 L 2.62,8.62 A 0.62,0.62 0 0,1 2.62,7.38 L 13.38,7.38 A 0.62,0.62 0 0,1 13.38,8.62 M 13.38,12.62 L 2.62,12.62 A 0.62,0.62 0 0,1 2.62,11.38 L 13.38,11.38 A 0.62,0.62 0 0,1 13.38,12.62" Width="18" Height="18" />
                <Button.Flyout>
                    <MenuFlyout x:Name="MainMenu" Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem Text="New tab" Click="OnMenuNewTab"/>
                        <MenuFlyoutItem Text="Close tab" Click="OnMenuCloseTab"/>
                        <MenuFlyoutItem Text="Reopen closed tab" Click="OnMenuReopenTab"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Bookmark this page" Click="OnBookmarkClick"/>
                        <MenuFlyoutItem Text="Bookmarks" Click="OnMenuBookmarks"/>
                        <MenuFlyoutItem Text="History" Click="OnMenuHistory"/>
                        <MenuFlyoutItem Text="Downloads" Click="OnMenuDownloads"/>
                        <MenuFlyoutItem Text="Settings" Click="OnMenuSettings"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Reload" Click="OnReload"/>
                        <MenuFlyoutItem Text="Update filters" Click="OnUpdateFilters"/>
                        <MenuFlyoutItem Text="What's new" Click="OnMenuWhatsNew"/>
                        <MenuFlyoutItem Text="About Nyx" Click="OnAbout"/>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

        </Grid>

        <!-- Bookmarks bar -->
        <ScrollViewer x:Name="BookmarksBarHost" Grid.Row="2" Background="{ThemeResource NyxToolbarBrush}" Visibility="Collapsed"
                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled">
            <StackPanel x:Name="BookmarksBar" Orientation="Horizontal" Padding="10,0,10,8" Spacing="4"/>
        </ScrollViewer>

        <Border Grid.Row="3" Background="{ThemeResource NyxDividerBrush}"/>

        <!-- Page area: one view per tab is added here -->
        <Grid x:Name="ContentHost" Grid.Row="4" Background="{ThemeResource NyxPageBrush}"/>

        <!-- Loading: a thin accent bar over the top of the page, shown only while a page is loading -->
        <muxc:ProgressBar x:Name="Loading" Grid.Row="4" Minimum="0" Maximum="100" Value="0" IsIndeterminate="False" Visibility="Collapsed" IsHitTestVisible="False"
                     Foreground="{ThemeResource NyxAccentBrush}" Background="{ThemeResource NyxDividerBrush}"
                     VerticalAlignment="Top" Height="4" Margin="0" Padding="0"/>

        <!-- Address bar suggestions (a popup, so it floats above the page) -->
        <Popup x:Name="SuggestPopup" Grid.RowSpan="5" IsLightDismissEnabled="False">
            <Border x:Name="SuggestBorder" Background="{ThemeResource NyxCardBrush}" BorderBrush="{ThemeResource NyxDividerBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="6" MaxHeight="420">
                <ListView x:Name="SuggestList" SelectionMode="None" IsItemClickEnabled="False"/>
            </Border>
        </Popup>

        <!-- Short messages (updates, downloads, extensions) -->
        <Popup x:Name="NoticePopup" Grid.RowSpan="5" IsLightDismissEnabled="False">
            <Border x:Name="NoticeBorder" Background="{ThemeResource NyxCardBrush}" BorderBrush="{ThemeResource NyxDividerBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="12,8" MaxWidth="520">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NoticeText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{ThemeResource NyxTextBrush}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="NoticeActionButton" Visibility="Collapsed" Click="OnNoticeAction" Style="{StaticResource AccentButtonStyle}"/>
                        <Button Content="Dismiss" Click="OnNoticeDismiss"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>

        <!-- Branded loading screen: continues the system splash screen until the first tab is ready -->
        <Grid x:Name="SplashOverlay" Grid.RowSpan="5" Background="#1B1040">
            <Image Source="ms-appx:///Assets/SplashScreen.png" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <muxc:ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="#CFC6FF" Background="#2E2452" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,76" CornerRadius="2"/>
        </Grid>
    </Grid>
</Page>
