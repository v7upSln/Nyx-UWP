        <!-- Category list -->
        <Grid Grid.Column="0" BorderBrush="{ThemeResource NyxDividerBrush}" BorderThickness="0,0,1,0" Padding="12,18,12,12">
            <StackPanel Spacing="10">
                <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" Margin="12,0,0,0" Foreground="{ThemeResource NyxTextBrush}"/>
                <ListView x:Name="Nav" SelectionMode="Single" SelectionChanged="OnNavChanged">
