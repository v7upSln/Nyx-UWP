11.13 M 8,10.36 C 6.7,10.36 5.64,9.3 5.64,8 C 5.64,6.7 6.7,5.64 8,5.64 C 9.3,5.64 10.36,6.7 10.36,8 C 10.36,9.3 9.3,10.36 8,10.36 M 8,6.65 C 7.26,6.65 6.65,7.26 6.65,8 C 6.65,8.74 7.26,9.35 8,9.35 C 8.74,9.35 9.35,8.74 9.35,8 C 9.35,7.26 8.74,6.65 8,6.65" Width="18" Height="18" /></Grid><TextBlock Text="General" FontSize="13" VerticalAlignment="Center"/></StackPanel></ListViewItem><ListViewItem Tag="search" Height="40" Padding="10,0"><StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"><Grid Width="18" Height="18"><PathIcon Data="F1 M 0,0 L 0.02,0 L 0,0.02 Z M 16,16 L 15.98,16 L 16,15.98 Z M 9.86,10.65 L 13.3,14.09 A 0.55,0.55 0 0,0 14.08,14.08 A 0.56,0.56 0 0,0 14.08,13.3 L 10.66,9.88 L 10.67,9.49 A 4.91,4.91 0 1,0 1.75,6.66 A 4.91,4.91 0 0,0 6.66,11.57 C 7.72,11.57 8.7,11.23 9.51,10.66 L 9.86,10.65 L 9.86,10.65 M 6.66,10.46 C 4.57,10.46 2.87,8.75 2.87,6.66 C 2.87,4.57 4.57,2.87 6.66,2.87 C 8.75,2.87 10.45,4.57 10.45,6.66 C 10.45,8.75 8.75,10.46 6.66,10.46" Width="18" Height="18" /></Grid><TextBlock Text="Search" FontSize="13" VerticalAlignment="Center"/></StackPanel></ListViewItem><ListViewItem Tag="privacy" Height="40" Padding="10,0"><StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"><Grid Width="18" Height="18"><PathIcon Data="F1 M 0,0 L 0.02,0 L 0,0.02 Z M 16,16 L 15.98,16 L 16,15.98 Z M 11.57,7.35 L 11.25,7.35 L 11.25,4.75 A 3.25,3.25 0 0,0 4.75,4.75 L 4.75,7.35 L 4.42,7.35 A 1.62,1.62 0 0,0 2.8,8.97 L 2.8,12.88 A 1.62,1.62 0 0,0 4.42,14.5 L 11.57,14.5 A 1.62,1.62 0 0,0 13.2,12.88 L 13.2,8.97 A 1.62,1.62 0 0,0 11.57,7.35 M 5.72,4.75 C 5.72,3.5 6.75,2.47 8,2.47 C 9.25,2.47 10.28,3.5 10.28,4.75 L 10.28,7.35 L 5.72,7.35 L 5.72,4.75 M 12.23,13 L 11.71,13.53 L 4.29,13.53 L 3.77,13 L 3.77,8.84 L 4.29,8.32 L 11.71,8.32 L 12.23,8.84 L 12.23,13" Width="18" Height="18" /></Grid><TextBlock Text="Privacy and security" FontSize="13" VerticalAlignment="Center"/></StackPanel></ListViewItem><ListViewItem Tag="filters" Height="40" Padding="10,0"><StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"><Grid Width="18" Height="18"><PathIcon Data="F1 M 0,0 L 0.02,0 L 0,0.02 Z M 16,16 L 15.98,16 L 16,15.98 Z M 8,1.5 C 11.59,1.5 14.5,4.41 14.5,8 C 14.5,11.59 11.59,14.5 8,14.5 C 4.41,14.5 1.5,11.59 1.5,8 C 1.5,4.41 4.41,1.5 8,1.5 M 3.86,4.72 C 3.15,5.62 2.72,6.76 2.72,8 C 2.72,10.92 5.08,13.28 8,13.28 C 9.24,13.28 10.38,12.85 11.28,12.14 L 3.86,4.72 M 8,2.72 C 6.76,2.72 5.62,3.15 4.72,3.86 L 12.14,11.28 C 12.85,10.38 13.28,9.24 13.28,8 C 13.28,5.08 10.92,2.72 8,2.72" Width="18" Height="18" /></Grid><TextBlock Text="Filters" FontSize="13" VerticalAlignment="Center"/></StackPanel></ListViewItem><ListViewItem Tag="about" Height="40" Padding="10,0"><StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"><Grid Width="18" Height="18"><PathIcon Data="F1 M 0,0 L 0.02,0 L 0,0.02 Z M 16,16 L 15.98,16 L 16,15.98 Z M 8,2.58 C 10.99,2.58 13.42,5.01 13.42,8 C 13.42,10.99 10.99,13.42 8,13.42 C 5.01,13.42 2.58,10.99 2.58,8 C 2.58,5.01 5.01,2.58 8,2.58 M 8,1.5 A 6.5,6.5 0 1,0 8,14.5 A 6.5,6.5 0 0,0 8,1.5 M 8,9.48 A 0.54,0.54 0 0,1 7.46,8.94 L 7.46,8.27 C 7.46,7.82 7.78,7.42 8.22,7.33 C 8.72,7.22 9.08,6.78 9.08,6.27 A 1.09,1.09 0 0,0 6.98,5.91 A 0.54,0.54 0 0,1 5.95,5.56 A 2.17,2.17 0 1,1 8.54,8.36 L 8.54,8.94 C 8.54,9.24 8.3,9.48 8,9.48 M 8.32,11.47 L 7.67,11.47 L 7.46,11.25 L 7.46,10.6 L 7.67,10.38 L 8.32,10.38 L 8.54,10.6 L 8.54,11.25 L 8.32,11.47" Width="18" Height="18" /></Grid><TextBlock Text="About" FontSize="13" VerticalAlignment="Center"/></StackPanel></ListViewItem>
                </ListView>
            </StackPanel>
        </Grid>

        <!-- Settings -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
            <StackPanel Margin="24,18,24,40" MaxWidth="760" HorizontalAlignment="Stretch">
                <TextBox x:Name="FindBox" HorizontalAlignment="Right" Width="260" Height="34" PlaceholderText="Find in Settings" TextChanged="OnFindChanged"/>
                <StackPanel x:Name="SecGeneral"><TextBlock Text="General" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource NyxTextBrush}"/><TextBlock Text="Appearance" FontSize="11" FontWeight="SemiBold" Margin="2,16,0,6" Foreground="{ThemeResource NyxMutedBrush}"/><Border Background="{ThemeResource NyxCardBrush}" BorderBrush="{ThemeResource NyxDividerBrush}" BorderThickness="1" CornerRadius="10"><StackPanel>
<Grid Tag="theme appearance dark light color" Padding="14,10" ColumnSpacing="16">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel VerticalAlignment="Center" Spacing="2">
    <TextBlock Text="Theme" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource NyxTextBrush}"/>
    <TextBlock Text="Choose how Nyx looks." FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource NyxMutedBrush}"/>
  </StackPanel>
  <ContentControl Grid.Column="1" VerticalAlignment="Center"><ComboBox x:Name="ThemeBox" MinWidth="180" SelectionChanged="OnThemeChanged"><ComboBoxItem Content="Match the system" Tag="system"/><ComboBoxItem Content="Light" Tag="light"/><ComboBoxItem Content="Dark" Tag="dark"/></ComboBox></ContentControl>
</Grid>
<Border Tag="divider" Height="1" Background="{ThemeResource NyxDividerBrush}"/>
<Grid Tag="websites dark mode force light appearance" Padding="14,10" ColumnSpacing="16">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel VerticalAlignment="Center" Spacing="2">
    <TextBlock Text="Websites" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource NyxTextBrush}"/>
    <TextBlock Text="Sites that support dark mode follow the theme. Force dark also darkens light sites (experimental)." FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource NyxMutedBrush}"/>
  </StackPanel>
  <ContentControl Grid.Column="1" VerticalAlignment="Center"><ComboBox x:Name="SiteBox" MinWidth="180" SelectionChanged="OnSiteAppearanceChanged"><ComboBoxItem Content="Match the Nyx theme" Tag="auto"/><ComboBoxItem Content="Always light" Tag="light"/><ComboBoxItem Content="Always dark" Tag="dark"/><ComboBoxItem Content="Force dark on light sites" Tag="force"/></ComboBox></ContentControl>
</Grid>
</StackPanel></Border><TextBlock Text="Toolbar" FontSize="11" FontWeight="SemiBold" Margin="2,16,0,6" Foreground="{ThemeResource NyxMutedBrush}"/><Border Background="{ThemeResource NyxCardBrush}" BorderBrush="{ThemeResource NyxDividerBrush}" BorderThickness="1" CornerRadius="10"><StackPanel>
<Grid Tag="bookmarks bar toolbar" Padding="14,10" ColumnSpacing="16">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel VerticalAlignment="Center" Spacing="2">
    <TextBlock Text="Show the bookmarks bar" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource NyxTextBrush}"/>
    <TextBlock Text="Shows your bookmarks under the address bar." FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource NyxMutedBrush}"/>
  </StackPanel>
  <ContentControl Grid.Column="1" VerticalAlignment="Center"><ToggleSwitch x:Name="BarSwitch" OnContent="" OffContent="" MinWidth="0" Toggled="OnBarToggled"/></ContentControl>
</Grid>
</StackPanel></Border><TextBlock Text="Updates" FontSize="11" FontWeight="SemiBold" Margin="2,16,0,6" Foreground="{ThemeResource NyxMutedBrush}"/><Border Background="{ThemeResource NyxCardBrush}" BorderBrush="{ThemeResource NyxDividerBrush}" BorderThickness="1" CornerRadius="10"><StackPanel>
<Grid Tag="updates check start release version" Padding="14,10" ColumnSpacing="16">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel VerticalAlignment="Center" Spacing="2">
    <TextBlock Text="Check for updates when Nyx starts" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource NyxTextBrush}"/>
    <TextBlock Text="If a newer release exists, its page opens in a new tab." FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource NyxMutedBrush}"/>
  </StackPanel>
  <ContentControl Grid.Column="1" VerticalAlignment="Center"><ToggleSwitch x:Name="UpdateSwitch" OnContent="" OffContent="" MinWidth="0" Toggled="OnUpdateToggled"/></ContentControl>
</Grid>
<Border Tag="divider" Height="1" Background="{ThemeResource NyxDividerBrush}"/>
<Grid Tag="updates check now release version" Padding="14,10" ColumnSpacing="16">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel VerticalAlignment="Center" Spacing="2">
    <TextBlock Text="Check for updates now" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource NyxTextBrush}"/>
    <TextBlock Text="Looks for a newer release in the Nyx repository." FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource NyxMutedBrush}"/>
  </StackPanel>
  <ContentControl Grid.Column="1" VerticalAlignment="Center"><Button Content="Check now" Click="OnCheckUpdatesNow"/></ContentControl>
</Grid>
</StackPanel></Border><TextBlock x:Name="UpdateNote" Margin="4,8,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource NyxMutedBrush}"/>
</StackPanel>
                <StackPanel x:Name="SecSearch"><TextBlock Text="Search" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource NyxTextBrush}"/><TextBlock Text="Search engine" FontSize="11" FontWeight="SemiBold" Margin="2,16,0,6" Foreground="{ThemeResource NyxMutedBrush}"/><Border Background="{ThemeResource NyxCardBrush}" BorderBrush="{ThemeResource NyxDividerBrush}" BorderThickness="1" CornerRadius="10"><StackPanel>
<Grid Tag="search engine default google" Padding="14,10" ColumnSpacing="16">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel VerticalAlignment="Center" Spacing="2">
    <TextBlock Text="Default search engine" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource NyxTextBrush}"/>
    <TextBlock Text="Used when you type a search in the address bar." FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource NyxMutedBrush}"/>
  </StackPanel>
  <ContentControl Grid.Column="1" VerticalAlignment="Center"><ComboBox x:Name="EngineBox" MinWidth="180" SelectionChanged="OnEngineChanged"></ComboBox></ContentControl>
</Grid>
<Border Tag="divider" Height="1" Background="{ThemeResource NyxDividerBrush}"/>
<Grid Tag="search suggestions address bar autocomplete" Padding="14,10" ColumnSpacing="16">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel VerticalAlignment="Center" Spacing="2">
    <TextBlock Text="Show search suggestions" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource NyxTextBrush}"/>
    <TextBlock Text="Your search engine suggests searches as you type in the address bar." FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource NyxMutedBrush}"/>
  </StackPanel>
  <ContentControl Grid.Column="1" VerticalAlignment="Center"><ToggleSwitch x:Name="SuggestSwitch" OnContent="" OffContent="" MinWidth="0" Toggled="OnSuggestToggled"/></ContentControl>
</Grid>
</StackPanel></Border></StackPanel>
                <StackPanel x:Name="SecPrivacy"><TextBlock Text="Privacy and security" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource NyxTextBrush}"/><TextBlock Text="Protection" FontSize="11" FontWeight="SemiBold" Margin="2,16,0,6" Foreground="{ThemeResource NyxMutedBrush}"/><Border Background="{ThemeResource NyxCardBrush}" BorderBrush="{ThemeResource NyxDividerBrush}" BorderThickness="1" CornerRadius="10"><StackPanel>
<Grid Tag="block ads trackers protection shield" Padding="14,10" ColumnSpacing="16">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel VerticalAlignment="Center" Spacing="2">
    <TextBlock Text="Block ads and trackers" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource NyxTextBrush}"/>
    <TextBlock Text="Blocks ad and tracker requests on every site." FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource NyxMutedBrush}"/>
  </StackPanel>
  <ContentControl Grid.Column="1" VerticalAlignment="Center"><ToggleSwitch x:Name="ProtectionSwitch" OnContent="" OffContent="" MinWidth="0" Toggled="OnProtectionToggled"/></ContentControl>
</Grid>
<Border Tag="divider" Height="1" Background="{ThemeResource NyxDividerBrush}"/>
<Grid Tag="popups pop-ups windows block" Padding="14,10" ColumnSpacing="16">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel VerticalAlignment="Center" Spacing="2">
    <TextBlock Text="Block pop-ups" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource NyxTextBrush}"/>
    <TextBlock Text="Stops sites from opening windows you did not ask for." FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource NyxMutedBrush}"/>
  </StackPanel>
  <ContentControl Grid.Column="1" VerticalAlignment="Center"><ToggleSwitch x:Name="PopupSwitch" OnContent="" OffContent="" MinWidth="0" Toggled="OnPopupToggled"/></ContentControl>
</Grid>
<Border Tag="divider" Height="1" Background="{ThemeResource NyxDividerBrush}"/>
<Grid Tag="tracking parameters utm fbclid links" Padding="14,10" ColumnSpacing="16">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel VerticalAlignment="Center" Spacing="2">
    <TextBlock Text="Remove tracking from addresses" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource NyxTextBrush}"/>
    <TextBlock Text="Strips parameters such as utm_source and fbclid from links." FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource NyxMutedBrush}"/>
  </StackPanel>
  <ContentControl Grid.Column="1" VerticalAlignment="Center"><ToggleSwitch x:Name="TrackingSwitch" OnContent="" OffContent="" MinWidth="0" Toggled="OnTrackingToggled"/></ContentControl>
</Grid>
</StackPanel></Border><TextBlock Text="History and site data" FontSize="11" FontWeight="SemiBold" Margin="2,16,0,6" Foreground="{ThemeResource NyxMutedBrush}"/><Border Background="{ThemeResource NyxCardBrush}" BorderBrush="{ThemeResource NyxDividerBrush}" BorderThickness="1" CornerRadius="10"><StackPanel>
<Grid Tag="history save browsing" Padding="14,10" ColumnSpacing="16">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel VerticalAlignment="Center" Spacing="2">
    <TextBlock Text="Save browsing history" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource NyxTextBrush}"/>
    <TextBlock Text="Keeps the pages you visit so you can find them again." FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource NyxMutedBrush}"/>
  </StackPanel>
  <ContentControl Grid.Column="1" VerticalAlignment="Center"><ToggleSwitch x:Name="HistorySwitch" OnContent="" OffContent="" MinWidth="0" Toggled="OnHistoryToggled"/></ContentControl>
</Grid>
<Border Tag="divider" Height="1" Background="{ThemeResource NyxDividerBrush}"/>
<Grid Tag="history clear delete" Padding="14,10" ColumnSpacing="16">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel VerticalAlignment="Center" Spacing="2">
    <TextBlock Text="Clear browsing history" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource NyxTextBrush}"/>
    <TextBlock Text="Removes every page from your history." FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource NyxMutedBrush}"/>
  </StackPanel>
  <ContentControl Grid.Column="1" VerticalAlignment="Center"><Button Content="Clear history" Click="OnClearHistory"/></ContentControl>
</Grid>
<Border Tag="divider" Height="1" Background="{ThemeResource NyxDividerBrush}"/>
<Grid Tag="cookies site data clear storage" Padding="14,10" ColumnSpacing="16">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel VerticalAlignment="Center" Spacing="2">
    <TextBlock Text="Cookies and site data" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource NyxTextBrush}"/>
    <TextBlock Text="Signs you out of sites and removes data they stored." FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource NyxMutedBrush}"/>
  </StackPanel>
  <ContentControl Grid.Column="1" VerticalAlignment="Center"><Button Content="Clear data" Click="OnClearSiteData"/></ContentControl>
</Grid>
</StackPanel></Border><TextBlock x:Name="PrivacyNote" Margin="4,8,0,0" FontSize="11" Foreground="{ThemeResource NyxMutedBrush}"/><TextBlock Text="Statistics" FontSize="11" FontWeight="SemiBold" Margin="2,16,0,6" Foreground="{ThemeResource NyxMutedBrush}"/><Border Background="{ThemeResource NyxCardBrush}" BorderBrush="{ThemeResource NyxDividerBrush}" BorderThickness="1" CornerRadius="10"><StackPanel>
<Grid Tag="statistics reset counters stats" Padding="14,10" ColumnSpacing="16">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel VerticalAlignment="Center" Spacing="2">
    <TextBlock Text="Protection statistics" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource NyxTextBrush}"/>
    <TextBlock Text="Resets the counters shown on the new tab page." FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource NyxMutedBrush}"/>
  </StackPanel>
  <ContentControl Grid.Column="1" VerticalAlignment="Center"><Button Content="Reset statistics" Click="OnResetStats"/></ContentControl>
</Grid>
</StackPanel></Border></StackPanel>
                <StackPanel x:Name="SecFilters"><TextBlock Text="Filters" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource NyxTextBrush}"/><TextBlock Text="Filter lists" FontSize="11" FontWeight="SemiBold" Margin="2,16,0,6" Foreground="{ThemeResource NyxMutedBrush}"/><Border Background="{ThemeResource NyxCardBrush}" BorderBrush="{ThemeResource NyxDividerBrush}" BorderThickness="1" CornerRadius="10"><StackPanel>
<Grid Tag="filters update lists" Padding="14,10" ColumnSpacing="16">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel VerticalAlignment="Center" Spacing="2">
    <TextBlock Text="Update filters now" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource NyxTextBrush}"/>
    <TextBlock Text="Lists update by themselves every 12 hours." FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource NyxMutedBrush}"/>
  </StackPanel>
  <ContentControl Grid.Column="1" VerticalAlignment="Center"><Button Content="Update now" Click="OnUpdateFilters" Style="{StaticResource AccentButtonStyle}"/></ContentControl>
</Grid>
<Border Tag="divider" Height="1" Background="{ThemeResource NyxDividerBrush}"/>
<Grid Tag="blocking method error empty compatibility" Padding="14,10" ColumnSpacing="16">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel VerticalAlignment="Center" Spacing="2">
    <TextBlock Text="Blocking method" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource NyxTextBrush}"/>
    <TextBlock Text="Network error behaves like Brave and is what ad block tests expect. Empty response is a compatibility fallback." FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource NyxMutedBrush}"/>
  </StackPanel>
  <ContentControl Grid.Column="1" VerticalAlignment="Center"><ComboBox x:Name="BlockBox" MinWidth="180" SelectionChanged="OnBlockModeChanged"><ComboBoxItem Content="Network error (recommended)" Tag="error"/><ComboBoxItem Content="Empty response" Tag="empty"/></ComboBox></ContentControl>
</Grid>
<Border Tag="divider" Height="1" Background="{ThemeResource NyxDividerBrush}"/>
<Grid Tag="youtube ads helper warning skip" Padding="14,10" ColumnSpacing="16">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel VerticalAlignment="Center" Spacing="2">
    <TextBlock Text="YouTube ads" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource NyxTextBrush}"/>
