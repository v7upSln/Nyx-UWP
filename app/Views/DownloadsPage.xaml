            <Button Content="Clear finished" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnClear"/>
        </Grid>
        <ListView x:Name="List" Grid.Row="1" SelectionMode="None"/>
    </Grid>
</Page>
