        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="14">
                <PathIcon Data="F1 M 0,0 L 0.02,0 L 0,0.02 Z M 16,16 L 15.98,16 L 16,15.98 Z M 12.95,13.85 L 3.05,13.85 A 1.81,1.81 0 0,1 1.25,12.05 L 1.25,3.95 C 1.25,2.96 2.06,2.15 3.05,2.15 L 5.72,2.15 A 1.81,1.81 0 0,1 7.04,2.73 L 8.17,3.95 L 12.95,3.95 C 13.94,3.95 14.75,4.76 14.75,5.75 L 14.75,12.05 A 1.81,1.81 0 0,1 12.95,13.85 M 2.91,3.27 L 2.38,3.81 L 2.38,12.19 L 2.91,12.73 L 13.09,12.73 L 13.62,12.19 L 13.62,5.62 L 13.09,5.08 L 7.93,5.08 L 7.52,4.9 L 6.22,3.49 A 0.68,0.68 0 0,0 5.72,3.27 L 2.91,3.27 L 2.91,3.27" Width="22" Height="22" />
